---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const products = {
  'precision-ceramic-white': {
    name: 'ArtTools Precision Ceramic White',
    image: '/assets/images/precision_ceramic_white.webp',
    material: 'Cerâmica',
    info: 'Acabamento cerâmico branco para traços precisos e uso criativo.'
  },
  'carbon-fiber-speedliner': {
    name: 'ArtTools Carbon Fiber Speedliner',
    image: '/assets/images/carbon_fiber_speedliner.webp',
    material: 'Fibra de carbono',
    info: 'Estrutura leve em fibra de carbono para escrita rápida e confortável.'
  },
  'titanium-stealth-minimalist': {
    name: 'ArtTools Titanium Stealth Minimalist',
    image: '/assets/images/titanium_stealth_minimalist.webp',
    material: 'Titânio',
    info: 'Corpo minimalista em titânio com equilíbrio para uso profissional.'
  },
  'minimalist-matte-slate': {
    name: 'ArtTools Minimalist Matte Slate',
    image: '/assets/images/minimalist_matte_slate.webp',
    material: 'Alumínio fosco',
    info: 'Acabamento slate fosco e grip texturizado para desenho técnico.'
  },
  'lunar-silver-monolith': {
    name: 'ArtTools Lunar Silver Monolith',
    image: '/assets/images/lunar_silver_monolith.webp',
    material: 'Aço prateado',
    info: 'Design monolítico prateado para linhas firmes e acabamento refinado.'
  },
  'obsidian-matte-black': {
    name: 'ArtTools Obsidian Matte Black',
    image: '/assets/images/obsidian_matte_black.webp',
    material: 'Metal preto fosco',
    info: 'Visual discreto e ergonômico para uso diário e escrita precisa.'
  },
  'brass-heritage-signature': {
    name: 'ArtTools Brass Heritage Signature',
    image: '/assets/images/brass_heritage_signature.webp',
    material: 'Latão escovado',
    info: 'Construção em latão com presença clássica e acabamento artesanal.'
  },
  'bronze-artisan-special': {
    name: 'ArtTools Bronze Artisan Special',
    image: '/assets/images/bronze_artisan_special.webp',
    material: 'Bronze',
    info: 'Edição artesanal em bronze para colecionadores e criadores exigentes.'
  },
  'midnight-gold-executive': {
    name: 'ArtTools Midnight Gold Executive',
    image: '/assets/images/midnight_gold_executive.webp',
    material: 'Metal dourado',
    info: 'Acabamento dourado executivo com desenho elegante para projetos premium.'
  }
};

export function getStaticPaths() {
  return [
    { params: { slug: 'precision-ceramic-white' } },
    { params: { slug: 'carbon-fiber-speedliner' } },
    { params: { slug: 'titanium-stealth-minimalist' } },
    { params: { slug: 'minimalist-matte-slate' } },
    { params: { slug: 'lunar-silver-monolith' } },
    { params: { slug: 'obsidian-matte-black' } },
    { params: { slug: 'brass-heritage-signature' } },
    { params: { slug: 'bronze-artisan-special' } },
    { params: { slug: 'midnight-gold-executive' } }
  ];
}

const product = products[Astro.params.slug as keyof typeof products] ?? products['precision-ceramic-white'];
---

<Layout
  title={`${product.name} | ArtTools`}
  description={product.info}
  image={product.image}
>
  <main class="product-detail-page">
    <section class="detail-shell">
      <div class="product-visual">
        <div class="image-stage">
          <img src={product.image} alt={`Caneta ${product.name}`} />
        </div>
      </div>

      <div class="product-info">
        <p class="eyebrow">Detalhes do produto</p>
        <h1>{product.name}</h1>
        <p class="lead">
          {product.info}
        </p>

        <div class="spec-list">
          <div>
            <span>Ponta</span>
            <strong>0,5 mm</strong>
          </div>
          <div>
            <span>Material</span>
            <strong>{product.material}</strong>
          </div>
          <div>
            <span>Fluxo</span>
            <strong>Traço premium</strong>
          </div>
          <div>
            <span>Uso</span>
            <strong>Uso criativo e técnico</strong>
          </div>
        </div>

        <div class="price-row">
          <div>
            <span class="label">Preço</span>
            <strong>R$ 499</strong>
          </div>
        </div>

        <div class="actions">
          <button class="notify-trigger" type="button" onclick="document.getElementById('avise-me').scrollIntoView({ behavior: 'smooth', block: 'start' }); document.getElementById('notify-name').focus();">
            Avisar-me
          </button>
        </div>
      </div>
    </section>

    <section id="avise-me" class="notify-panel" aria-live="polite">
      <div class="notify-card">
        <p class="notify-kicker">Receba um aviso</p>
        <h2>Quero saber quando esse produto chegar.</h2>

        <form
          class="notify-form"
          onsubmit={`event.preventDefault(); const form = event.currentTarget; const nome = form.nome.value.trim(); const telefone = form.telefone.value.trim(); const email = form.email.value.trim(); if (!nome || !telefone || !email) return; alert('Obrigado, ' + nome + '! Receberemos seu contato em ' + email + ' e entraremos em contato no telefone ' + telefone + ' quando a ${product.name} estiver disponível.'); form.reset();`}
        >
          <label>
            <span>Seu nome</span>
            <input id="notify-name" name="nome" type="text" placeholder="Seu nome completo" required />
          </label>

          <label>
            <span>Seu telefone</span>
            <input name="telefone" type="tel" placeholder="(11) 99999-9999" required />
          </label>

          <label>
            <span>Seu e-mail</span>
            <input id="notify-email" name="email" type="email" placeholder="seu@email.com" required />
          </label>

          <button type="submit">Avise-me</button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<style>
  .product-detail-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at top, rgba(255,255,255,0.7), transparent 30%),
      #f5f5f4;
    padding: 7rem 1.25rem 5rem;
    color: #1c1917;
  }

  .detail-shell {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: stretch;
  }

  .product-visual {
    background: linear-gradient(135deg, #f1f1ef 0%, #eceae4 100%);
    border: 1px solid rgba(28, 25, 23, 0.75);
    border-radius: 0.75rem;
    padding: 1rem;
    min-height: 620px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 18px -12px rgba(28, 25, 23, 0.5);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .product-visual:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 24px -16px rgba(28, 25, 23, 0.45);
  }

  .image-stage {
    width: 100%;
    height: 100%;
    min-height: 560px;
    display: block;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 0.5rem;
    overflow: hidden;
    padding: 0;
    box-shadow: 0 6px 14px -10px rgba(28, 25, 23, 0.8);
  }

  .image-stage img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: drop-shadow(0 24px 30px rgba(15, 23, 42, 0.12));
    transition: transform 0.45s ease;
  }

  .image-stage img:hover {
    transform: scale(1.02);
  }

  .product-info {
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(28, 25, 23, 0.75);
    border-radius: 0.75rem;
    padding: 2rem;
    box-shadow: 0 10px 20px -16px rgba(28, 25, 23, 0.45);
    transition: transform 0.3s ease;
  }

  .product-info:hover {
    transform: translateY(-2px);
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #57534e;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 4.7rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  .lead {
    margin: 1rem 0 2rem;
    color: #4b5563;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .spec-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .spec-list div {
    background: rgba(28, 25, 23, 0.02);
    border: 1px solid rgba(28, 25, 23, 0.06);
    border-radius: 0.5rem;
    padding: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .spec-list div:hover {
    border-color: rgba(28, 25, 23, 0.12);
    transform: translateY(-1px);
  }

  .spec-list span {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #6b7280;
    margin-bottom: 0.45rem;
  }

  .spec-list strong {
    font-size: 1.05rem;
    color: #1c1917;
  }

  .price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 0.4rem;
  }

  .price-row strong {
    font-size: 2rem;
    letter-spacing: -0.06em;
  }

  .actions {
    width: 100%;
  }

  .notify-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 1.3rem;
    border: none;
    background: #1c1917;
    color: #f5f5f4;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease;
    box-shadow: 0 10px 20px -16px rgba(28, 25, 23, 0.5);
  }

  .notify-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 24px -18px rgba(28, 25, 23, 0.42);
  }

  .notify-panel {
    max-width: 1200px;
    margin: 2rem auto 0;
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .notify-panel:target,
  .notify-panel:focus-within {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .notify-card {
    background: linear-gradient(180deg, #1c1917 0%, #201d1b 100%);
    color: #f5f5f4;
    border-radius: 0.75rem;
    padding: 2rem;
    box-shadow: 0 24px 40px -32px rgba(28, 25, 23, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .notify-kicker {
    margin: 0 0 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d6d3d1;
  }

  .notify-card h2 {
    margin: 0 0 1.2rem;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.05em;
  }

  .notify-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.2rem;
    align-items: end;
  }

  .notify-form label {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: #f5f5f4;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .notify-form label:last-of-type {
    grid-column: 1 / -1;
  }

  .notify-form input {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: #f5f5f4;
    border-radius: 0.5rem;
    padding: 0.95rem 1rem;
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .notify-form input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
  }

  .notify-form input::placeholder {
    color: rgba(245, 245, 244, 0.55);
  }

  .notify-form button {
    grid-column: 1 / -1;
    width: 100%;
    border: none;
    background: #f5f5f4;
    color: #1c1917;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 16px 24px -20px rgba(255,255,255,0.45);
  }

  .notify-form button:hover {
    transform: translateY(-1px);
    opacity: 0.98;
  }

  @media (max-width: 980px) {
    .detail-shell {
      grid-template-columns: 1fr;
    }

    .product-visual {
      min-height: 420px;
    }

    .notify-form {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
