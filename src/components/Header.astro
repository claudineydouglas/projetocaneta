---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Início', href: '/', match: ['/'] },
  { label: 'Catálogo', href: '/segunda-pagina', match: ['/segunda-pagina'] },
  { label: 'Detalhes', href: '/detalhes', match: ['/detalhes'] }
];
---

<header id="navbar" class="fixed top-0 w-full z-50 px-8 sm:px-12 md:px-16 py-7 transition-all duration-300">
	<div class="max-w-[1440px] mx-auto flex justify-between items-center gap-6">
		<a href="/" class="flex items-center gap-3 group" aria-label="ARTOOLS Home">
			<div class="w-8 h-8 bg-[#1C1917] text-white flex items-center justify-center rounded-[7px] shadow-sm group-hover:scale-105 transition-transform">
				<iconify-icon icon="solar:pen-bold" class="text-base text-white"></iconify-icon>
			</div>
			<span class="font-display font-bold text-lg tracking-tight text-[#1C1917]">ARTOOLS</span>
		</a>

		<nav class="hidden md:flex items-center gap-3 text-[10px] font-mono tracking-[0.2em] uppercase" aria-label="Navegação principal">
			{navItems.map((item) => {
				const isActive = item.match.includes(currentPath);
				return (
					<a
						href={item.href}
						class:list={[
							'px-3 py-2 transition-colors relative',
							isActive ? 'text-stone-900 font-semibold' : 'text-stone-500 hover:text-stone-900'
						]}
						aria-current={isActive ? 'page' : undefined}
					>
						<span class="relative z-10">{item.label}</span>
						{isActive && <span class="absolute inset-x-2 bottom-1 h-px bg-stone-900"></span>}
					</a>
				);
			})}
		</nav>
	</div>

	<nav aria-label="Navegação móvel" class="mt-4 flex justify-center gap-3 text-[10px] font-mono uppercase md:hidden">
		{navItems.map((item) => {
			const isActive = item.match.includes(currentPath);
			return (
				<a
					href={item.href}
					class:list={[
						'px-2 py-1.5 transition-colors',
						isActive ? 'text-stone-900 font-semibold' : 'text-stone-600'
					]}
					aria-current={isActive ? 'page' : undefined}
				>
					{item.label}
				</a>
			);
		})}
	</nav>
</header>
