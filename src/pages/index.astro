---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Layout from '../layouts/Layout.astro';
import TechCard from '../components/TechCard.astro';
import TextType from '../components/TextType.astro';
import artToolsArtisanPen from '../assets/artools_artisan_pen.webp';
import artToolsTechFeature from '../assets/artools_tech_feature.webp';
---

<Layout
    title="ArtTools Precision Pen | A caneta criada para a precisão"
    description="Conheça a ArtTools Precision Pen, uma caneta tecnológica que combina equilíbrio, fluxo e design para criadores que exigem perfeição em cada traço."
    image="https://raw.githubusercontent.com/claudineydouglas/projetocaneta/main/public/assets/images/artools_artisan_pen.webp"
>
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<!-- Top Reading Progress Indicator -->
<div id="scroll-progress-bar" aria-hidden="true"></div>



    <!-- Global Noise Grain Texture Layer -->
    <div class="noise-layer" aria-hidden="true"></div>

    <!-- ==========================================================================
         HERO SCROLL CONTAINER
         ========================================================================== -->
    <main id="main-content" class="relative bg-[#EAEAE5]">
        <div id="hero-trigger" class="relative w-full h-[380vh]">

            <!-- STICKY FULLSCREEN VIEWPORT -->
            <div class="sticky top-0 h-screen w-full overflow-hidden flex items-center bg-[#EAEAE5]">

                <!-- ==============================================================
                     1. FULLSCREEN BACKGROUND VIDEO (WALL-TO-WALL, CENTERED)
                     ============================================================== -->
                <div class="absolute inset-0 w-full h-full overflow-hidden z-0 pointer-events-none">
                    <video id="hero-video" poster="/assets/images/artools_artisan_pen.webp" src="/assets/videos/video2.mp4" muted playsinline preload="auto"
                        class="w-full h-full object-cover object-center will-change-transform"
                        aria-label="Vídeo de fundo da caneta ARTOOLS controlado pelo scroll">
                    </video>

                    <!-- Subtle Lighting Gradient for Crisp Text Contrast -->
                    <div
                        class="absolute inset-0 bg-gradient-to-r from-[#EAEAE5]/95 via-[#EAEAE5]/40 to-transparent pointer-events-none">
                    </div>
                </div>

                <!-- ==============================================================
                     2. LEFT COLUMN: TEXT CONTENT (SPACED GENEROUSLY FROM HEADER)
                     Com efeito de Fade In/Out e Blur In/Out (Aparecendo e Sumindo)
                     ============================================================== -->
                <div
                    class="relative z-20 w-full max-w-[1440px] mx-auto h-full px-8 sm:px-12 md:px-16 lg:px-20 pointer-events-none">

                    <!-- ==========================================================
                         BEAT 1: HEADLINE PRINCIPAL (MATCHING EXACT REFERENCE IMAGE)
                         ========================================================== -->
                    <div id="text-beat-1" class="editorial-beat">

                        <!-- Headline: A caneta / mais tecnológica (outline) / do mundo. -->
                        <h1
                            class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[5.2rem] font-bold tracking-tighter leading-[0.94] mb-6 text-stone-900">
                            <span class="block">A caneta</span>
                            <span class="block text-outline-hero my-1.5">mais tecnológica</span>
                            <span class="block">do mundo</span>
                        </h1>

                        <!-- Subheadline (Matching Reference Wording & Rhythm) -->
                        <p class="text-base sm:text-lg text-stone-600 leading-relaxed font-light mb-9 max-w-md">
                            A Artools Precision Pen redefine o equilíbrio entre peso, fluxo e design. Feita para
                            criadores que exigem perfeição em cada traço.
                        </p>

                        <!-- Buttons: Saiba mais (White Pill) + Explorar ↓ (Black Pill) -->
                        <div class="flex items-center gap-4 flex-wrap">
                            <!-- Secondary White Floating Pill Button -->
                            <Button variant="explore" label="Saiba mais" href="#craft-section" icon="solar:arrow-right-linear" title="Saiba mais" />

                            <!-- Primary Black Pill Button -->
                            <Button label="Explorar" href="#craft-section" icon="solar:arrow-down-linear" />
                        </div>

                    </div>

                    <!-- ==========================================================
                         BEAT 2: SEGUNDO ATO (Surge com Fade In & Blur In no meio do scroll)
                         ========================================================== -->
                    <div id="text-beat-2" class="editorial-beat opacity-0 pointer-events-none"
                        style="filter: blur(20px);">

                        <h2
                            class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tighter leading-[0.98] mb-6 text-stone-900">
                            <span class="block">Engenharia Suíça.</span>
                            <span class="block text-outline-hero my-1.5">Precisão Molecular.</span>
                        </h2>

                        <p class="text-base sm:text-lg text-stone-600 leading-relaxed font-light mb-9 max-w-md">
                            Nossa arquitetura de fluxo proprietária sincroniza a deposição de tinta em tempo real sobre
                            um chassi de alumínio aeroespacial usinado em 5 eixos.
                        </p>

                        <div class="flex items-center gap-4">
                            <Button variant="explore" label="Ver Especificações" href="#specs" icon="solar:arrow-right-linear" iconClass="text-base" />
                        </div>

                    </div>

                    <!-- ==========================================================
                         BEAT 3: TERCEIRO ATO (Surge com Fade In & Blur In no final do scroll)
                         ========================================================== -->
                    <div id="text-beat-3" class="editorial-beat opacity-0 pointer-events-none"
                        style="filter: blur(20px);">

                        <h2
                            class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tighter leading-[0.98] mb-6 text-stone-900">
                            <span class="block">Perfeição em</span>
                            <span class="block text-outline-hero my-1.5">cada traço.</span>
                        </h2>

                        <p class="text-base sm:text-lg text-stone-600 leading-relaxed font-light mb-9 max-w-md">
                            O instrumento definitivo para criadores que não aceitam concessões. Primeiro lote limitado
                            numerado a laser.
                        </p>

                        <div class="flex items-center gap-4">
                            <Button label="Garantir Unidade" title="Compras em breve" icon="solar:arrow-right-linear" />
                        </div>

                    </div>

                </div>

                <!-- ==============================================================
                     3. RIGHT SIDE: 01 INDICATOR & VERTICAL LINE (EXACTLY AS IN IMAGE)
                     ============================================================== -->
                <div
                    class="hidden md:flex absolute top-1/2 -translate-y-1/2 right-12 lg:right-16 flex-col items-center gap-4 z-20 pointer-events-none">
                    <span id="step-number" class="text-xs font-mono text-stone-600 font-medium">01</span>
                    <div class="w-[1px] h-14 bg-stone-400/80"></div>
                </div>

                <!-- ==============================================================
                     4. BOTTOM: SCROLL TO CONTROL & LINE (EXACTLY AS IN IMAGE)
                     ============================================================== -->
                <div id="scroll-prompt"
                    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-3 pointer-events-none transition-opacity duration-300">
                    <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-stone-400">SCROLL TO
                        CONTROL</span>
                    <div class="w-[1px] h-8 bg-stone-300 overflow-hidden relative">
                        <div class="w-full h-full bg-stone-900 animate-scroll-tracer"></div>
                    </div>
                </div>

            </div>

        </div>


    <!-- ==========================================================================
         SEGUNDA DOBRA: ARQUITETURA & ENGENHARIA DE PRECISÃO
         Alinhada 100% à identidade visual da primeira dobra: fundo canvas #EAEAE5,
         tipografia Space Grotesk com text-outline-hero, botões pill da marca
         e composição inspirada na imagem de referência com moldura de cantoneiras.
         ========================================================================== -->
    <section id="craft-section" class="relative bg-[#EAEAE5] text-stone-900 min-h-screen py-24 sm:py-32 md:py-40 overflow-hidden z-30 selection:bg-stone-900 selection:text-white border-t border-stone-300/70">

        <!-- Fine Subtle Architectural Grid Lines in Stone -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(28,25,23,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(28,25,23,0.03)_1px,transparent_1px)] bg-[size:5rem_5rem] pointer-events-none"></div>

        <div class="craft-content-wrap max-w-[1440px] mx-auto px-8 sm:px-12 md:px-16 lg:px-20 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 xl:gap-24 items-stretch">

                <!-- ==============================================================
                     COLUNA ESQUERDA: FOTOGRAFIA DE ESTÚDIO COM MOLDURA TÉCNICA
                     (Altura 100% nivelada à coluna de texto ao lado)
                     ============================================================== -->
                <div class="w-full h-full flex justify-center lg:justify-start">
                    <div class="craft-frame-group relative w-full h-full min-h-[420px] md:min-h-full flex flex-col">

                        <!-- Cantoneiras Arquitetônicas Deslocadas (Offset Corner Brackets) -->
                        <div class="craft-bracket-tl" aria-hidden="true"></div>
                        <div class="craft-bracket-br" aria-hidden="true"></div>

                        <!-- Card da Imagem com Moldura Fina e Sombra Refinada ocupando 100% da altura -->
                        <div class="craft-image-box relative w-full h-full flex-1 rounded-[4px] overflow-hidden border border-stone-300/90 bg-stone-900 shadow-[0_25px_60px_-15px_rgba(28,25,23,0.18)]">
                            
                            <!-- Imagem Principal da Caneta ARTOOLS Pigmentum (Cobre 100% da altura com object-cover) -->
                            <Image
                                id="craft-photo"
                                src={artToolsArtisanPen}
                                alt="Caneta ARTOOLS Pigmentum sob foco de luz em mesa de projetos técnicos"
                                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out select-none will-change-transform"
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                            />

                            <!-- Vinheta Suave e Gradiente para Acabamento -->
                            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/60 via-transparent to-transparent pointer-events-none"></div>

                            <!-- Micro-Badge Tecnológico Flutuante da ARTOOLS -->
                            <div class="absolute bottom-5 left-5 bg-[#1C1917]/90 text-white backdrop-blur-md px-4 py-1.5 rounded-full border border-stone-700/80 flex items-center gap-2.5 shadow-md pointer-events-none">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="font-mono text-[10.5px] tracking-[0.2em] text-stone-200 uppercase font-medium">ARTOOLS • PIGMENTUM 0.1</span>
                            </div>

                            <!-- Código de Série no Canto Superior -->
                            <div class="absolute top-4 right-5 pointer-events-none">
                                <span class="font-mono text-[9px] tracking-[0.25em] text-white/70 uppercase">SERIES-01 // ARCHIVAL</span>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- ==============================================================
                     COLUNA DIREITA: TIPOGRAFIA SPACE GROTESK & NARRATIVA TÉCNICA
                     (Texto com distribuição vertical harmoniosa)
                     ============================================================== -->
                <div class="w-full flex flex-col justify-between py-1">

                    <!-- Eyebrow / Tag -->
                    <div class="craft-anim inline-flex items-center gap-3 mb-5">
                        <span class="w-2 h-2 rounded-full bg-stone-900"></span>
                        <span class="font-mono text-xs tracking-[0.25em] text-stone-500 uppercase font-medium">
                            02 // ARQUITETURA & PRECISÃO DO TRAÇO
                        </span>
                    </div>

                    <!-- Headline Principal com efeito de digitação -->
                    <h2 class="craft-anim font-display text-4xl sm:text-5xl lg:text-6xl xl:text-[4.4rem] font-bold tracking-tighter leading-[0.94] mb-7 text-stone-900">
                        <TextType
                            as="span"
                            text={["Engenharia artesanal.", "Precisão molecular.", "Traço sem compromisso."]}
                            typingSpeed={70}
                            deletingSpeed={35}
                            pauseDuration={1500}
                            loop={true}
                            showCursor={true}
                            cursorCharacter="|"
                            className="block"
                            textColors={['#1c1917', '#1c1917', '#1c1917']}
                        />
                    </h2>

                    <!-- Parágrafo Narrativo dos Benefícios da Caneta Tecnológica -->
                    <p class="craft-anim text-base sm:text-lg text-stone-600 leading-relaxed font-light mb-9 max-w-xl">
                        Distante da descartabilidade em massa, cada instrumento ARTOOLS Pigmentum nasce de um rigor quase cirúrgico. Projetada para criadores conceituais, arquitetos e mestres do traço, sua arquitetura integra uma câmara interna de micropressão barométrica autocompensada e ponta de liga de tungstênio usinada em 0.1mm. O resultado é uma deposição contínua de nanopigmentos de carbono japonês com densidade óptica homogênea — sem falhas, sem vazamentos e com durabilidade indelével e eterna à prova d'água e luz UV.
                    </p>

                    <!-- Métricas / Badges de Precisão (Layout inspirado na imagem de referência) -->
                    <div class="craft-anim grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-10 pt-6 pb-9 border-t border-stone-300 mb-4">

                        <!-- Métrica 1: Calibração da Ponta -->
                        <div class="flex gap-4 items-start group">
                            <div class="craft-stat-bar w-[2px] h-12 bg-stone-900 shrink-0 mt-1 origin-top transition-transform duration-300 group-hover:scale-y-110"></div>
                            <div>
                                <div class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 leading-none">
                                    0.1 mm
                                </div>
                                <div class="font-sans text-sm text-stone-700 font-medium mt-1.5">
                                    Ponta Calibrada a Laser
                                </div>
                                <div class="font-mono text-[11px] text-stone-500 mt-0.5 tracking-wider uppercase">
                                    Tolerância Micrométrica 5-Eixos
                                </div>
                            </div>
                        </div>

                        <!-- Métrica 2: Tinta Pigmentada Pura -->
                        <div class="flex gap-4 items-start group">
                            <div class="craft-stat-bar w-[2px] h-12 bg-stone-900 shrink-0 mt-1 origin-top transition-transform duration-300 group-hover:scale-y-110"></div>
                            <div>
                                <div class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 leading-none">
                                    100% Carbon
                                </div>
                                <div class="font-sans text-sm text-stone-700 font-medium mt-1.5">
                                    Nanopigmentos Japoneses
                                </div>
                                <div class="font-mono text-[11px] text-stone-500 mt-0.5 tracking-wider uppercase">
                                    Resistente a Água & Raios UV
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Botões de Ação Lado a Lado (Disposição Elegante em Linha) -->
                    <div class="craft-anim flex items-center gap-4 sm:gap-5 pt-3 flex-nowrap">
                        <Button label="Comprar Agora" title="Compras em breve" className="shrink-0 whitespace-nowrap" />

                        <Button variant="explore" label="Ver Especificações" href="#specs" icon="solar:arrow-right-linear" iconClass="btn-arrow-icon text-base group-hover:translate-x-1 transition-transform" className="shrink-0 whitespace-nowrap" />
                    </div>

                </div>

            </div>
        </div>

    </section>

    <!-- ==========================================================================
         TERCEIRA DOBRA: ANATOMIA TECNOLÓGICA & PILARES DE PRECISÃO
         Apresentação técnica detalhada dos 4 pilares de engenharia da caneta,
         utilizando Bento Grid refinado com imagem macro, métricas de precisão
         e tipografia Space Grotesk/Inter alinhada 100% à identidade do projeto.
         ========================================================================== -->
    <section id="tech-section" class="relative bg-[#EAEAE5] text-stone-900 min-h-screen py-24 sm:py-32 md:py-40 overflow-hidden z-30 selection:bg-stone-900 selection:text-white border-t border-stone-300/80">

        <!-- Fine Subtle Architectural Grid Lines in Stone -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(28,25,23,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(28,25,23,0.03)_1px,transparent_1px)] bg-[size:5rem_5rem] pointer-events-none"></div>

        <div class="tech-content-wrap max-w-[1440px] mx-auto px-8 sm:px-12 md:px-16 lg:px-20 relative z-10">

            <!-- ==============================================================
                 CABEÇALHO DA SEÇÃO (EDITORIAL HEADER)
                 ============================================================== -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-14 sm:mb-18 md:mb-20">
                <div>
                    <!-- Eyebrow / Tag -->
                    <div class="tech-anim inline-flex items-center gap-3 mb-5">
                        <span class="w-2 h-2 rounded-full bg-stone-900"></span>
                        <span class="font-mono text-xs tracking-[0.25em] text-stone-500 uppercase font-medium">
                            03 // ARQUITETURA DE COMPONENTES
                        </span>
                    </div>

                    <!-- Headline Principal (Space Grotesk + text-outline-hero) -->
                    <h2 class="tech-anim font-display text-4xl sm:text-5xl lg:text-6xl xl:text-[4.4rem] font-bold tracking-tighter leading-[0.94] text-stone-900 max-w-2xl">
                        <span class="block">Anatomia do traço.</span>
                        <span class="block text-outline-hero my-1.5">Cada mícron calculado.</span>
                    </h2>
                </div>

                <!-- Subtítulo de Contexto Técnico -->
                <p class="tech-anim text-base sm:text-lg text-stone-600 font-light leading-relaxed max-w-md">
                    Quatro sistemas proprietários desenvolvidos para anular o atrito, equalizar a pressão interna e estabilizar a deposição contínua de tinta em qualquer ângulo de escrita.
                </p>
            </div>

            <!-- ==============================================================
                 BENTO GRID TÉCNICO (OS 4 PILARES DA ENGENHARIA ARTOOLS)
                 ============================================================== -->
            <div class="tech-carousel mb-12 sm:mb-16" data-tech-carousel>
                <div class="tech-carousel-track">

                    <TechCard
                        active
                        eyebrow="CHASSI & ERGONOMIA DINÂMICA"
                        badge="CNC 5-EIXOS"
                        title="Empunhadura Texturizada em Padrão Diamante"
                        description="Usinada em torno de altíssima precisão a partir de um tarugo maciço de alumínio aeroespacial. O padrão recartilhado microdiamantado proporciona ancoragem tátil perfeita sem fadiga muscular, posicionando o centro de gravidade dinâmico no ponto de equilíbrio áureo (62/38)."
                        image={artToolsTechFeature}
                        imageAlt="Macro fotografia do grip recartilhado e gravação a laser da caneta ARTOOLS Pigmentum"
                        imageBadges={["LIGA AEROESPACIAL 6061-T6", "MASSA EQUILIBRADA: 19.4G"]}
                    />

                    <TechCard
                        eyebrow="FLUIDODINÂMICA"
                        status
                        icon="solar:compass-bold"
                        title="Equalização Hidrostática Ativa"
                        description="Um labirinto capilar interno compensa instantaneamente flutuações de temperatura e pressão ambiente (inclusive em cabines de avião pressurizadas), anulando qualquer risco de vazamento e mantendo a vazão calibrada em qualquer inclinação."
                        metrics={[
                            { value: '0.00%', label: 'Vazamento em Altitude' },
                            { value: '360°', label: 'Operação Angular' },
                        ]}
                    />

                    <TechCard
                        eyebrow="RESISTÊNCIA MECÂNICA"
                        badge="CALIBRE 0.1MM"
                        icon="solar:shield-check-bold"
                        title="Ponta em Liga de Tungstênio"
                        description="Microesfera de carbeto de tungstênio indeformável. Suporta mais de 400g de pressão mecânica vertical sem alargar, bifurcar ou perder a espessura nominal de 0.100mm, garantindo estabilidade linear por quilômetros de traçado."
                        metrics={[
                            { value: '400 g', label: 'Tolerância à Pressão' },
                            { value: '±0.002mm', label: 'Desvio Máximo' },
                        ]}
                    />

                    <TechCard
                        eyebrow="QUÍMICA MOLECULAR ARCHIVAL"
                        badge="100% INDELÉVEL"
                        title="Tinta Japonesa com Nanocarbono Puro"
                        description="Partículas de carbono coloidal refinadas em escala nanométrica que realizam microancoragem imediata na fibra do papel. Secagem ultrarrápida, zero sangramento nas margens e resistência comprovada contra umidade, solventes e raios UV."
                        metrics={[
                            { value: '2.8 seg', label: 'Secagem Rápida', detail: 'Zero Borrões' },
                            { value: '3.2 D', label: 'Densidade Óptica', detail: 'Preto Profundo' },
                            { value: '100+ Anos', label: 'Grau Archival', detail: 'ISO 14145-2' },
                        ]}
                    />

                    <template>

                <!-- ----------------------------------------------------------
                     CARD 1 (HERO CARD - 7 COLUNAS): GRIP DIAMANTADO & CHASSI
                     ---------------------------------------------------------- -->
                <div class="tech-card tech-slide is-active bg-white rounded-[6px] border border-stone-300/90 p-8 sm:p-10 shadow-[0_15px_40px_-15px_rgba(28,25,23,0.08)] flex flex-col justify-between group hover:border-stone-900 transition-colors duration-300 relative overflow-hidden" data-tech-slide aria-hidden="false">
                    
                    <div class="mb-8">
                        <div class="flex items-center justify-between gap-4 mb-4">
                            <span class="font-mono text-[11px] tracking-[0.2em] text-stone-500 uppercase font-medium">
                                CHASSI & ERGONOMIA DINÂMICA
                            </span>
                            <span class="font-mono text-[10px] bg-stone-100 text-stone-700 px-2.5 py-1 rounded border border-stone-200 uppercase">
                                CNC 5-EIXOS
                            </span>
                        </div>
                        <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 mb-3">
                            Empunhadura Texturizada em Padrão Diamante
                        </h3>
                        <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed max-w-xl">
                            Usinada em torno de altíssima precisão a partir de um tarugo maciço de alumínio aeroespacial. O padrão recartilhado microdiamantado proporciona ancoragem tátil perfeita sem fadiga muscular, posicionando o centro de gravidade dinâmico no ponto de equilíbrio áureo (62/38).
                        </p>
                    </div>

                    <!-- Visual Showcase: Macro Fotografia do Chassi e Ponta -->
                    <div class="relative rounded-[4px] overflow-hidden border border-stone-200 bg-stone-950 p-2 group-hover:border-stone-400 transition-colors">
                        <Image
                             src={artToolsTechFeature}
                             alt="Macro fotografia do grip recartilhado e gravação a laser da caneta ARTOOLS Pigmentum"
                             class="w-full h-56 sm:h-64 object-cover object-center rounded-[3px] group-hover:scale-105 transition-transform duration-700 ease-out select-none"
                             loading="lazy"
                             decoding="async"
                        />
                        
                        <!-- Badges Técnicos Flutuantes -->
                        <div class="absolute bottom-4 left-4 bg-stone-900/90 text-white backdrop-blur-md px-3 py-1 rounded text-[10px] font-mono tracking-wider uppercase border border-stone-700">
                            LIGA AEROESPACIAL 6061-T6
                        </div>
                        <div class="absolute bottom-4 right-4 bg-white/95 text-stone-900 backdrop-blur-md px-3 py-1 rounded text-[10px] font-mono tracking-wider uppercase border border-stone-300 font-medium">
                            MASSA EQUILIBRADA: 19.4G
                        </div>
                    </div>

                </div>

                <!-- ----------------------------------------------------------
                     CARD 2 (5 COLUNAS): CÂMARA BAROMÉTRICA DE MICROPRESSÃO
                     ---------------------------------------------------------- -->
                <div class="tech-card tech-slide bg-white rounded-[6px] border border-stone-300/90 p-8 sm:p-10 shadow-[0_15px_40px_-15px_rgba(28,25,23,0.08)] flex flex-col justify-between group hover:border-stone-900 transition-colors duration-300" data-tech-slide aria-hidden="true">
                    
                    <div>
                        <div class="flex items-center justify-between gap-4 mb-4">
                            <span class="font-mono text-[11px] tracking-[0.2em] text-stone-500 uppercase font-medium">
                                FLUIDODINÂMICA
                            </span>
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        </div>

                        <!-- Ícone Técnico -->
                        <div class="w-12 h-12 bg-stone-100 rounded-lg flex items-center justify-center text-stone-900 mb-6 border border-stone-200 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-300">
                            <iconify-icon icon="solar:compass-bold" class="text-2xl"></iconify-icon>
                        </div>

                        <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 mb-3">
                            Equalização Hidrostática Ativa
                        </h3>
                        <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed mb-6">
