                const slides = [...carousel.querySelectorAll<HTMLElement>('[data-tech-slide]')];
                const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-tech-dot]')];
                const previous = carousel.querySelector('[data-tech-prev]');
                const next = carousel.querySelector('[data-tech-next]');
                let activeIndex = 0;
                let autoplay: number | undefined;
                let transitionTimer: number | undefined;

                const showSlide = (nextIndex: number, direction?: number) => {
                    const previousIndex = activeIndex;
