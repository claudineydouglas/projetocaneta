---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Metric {
    value: string;
    label: string;
    detail?: string;
}

interface Props {
    eyebrow: string;
    badge?: string;
    status?: boolean;
    icon?: string;
    title: string;
    description: string;
    metrics?: Metric[];
    image?: ImageMetadata;
    imageAlt?: string;
    imageBadges?: string[];
    active?: boolean;
}

const {
    eyebrow,
    badge,
    status = false,
    icon,
    title,
    description,
    metrics = [],
    image,
    imageAlt = '',
    imageBadges = [],
    active = false,
} = Astro.props;
---

<article
    class:list={[
        'tech-card tech-slide bg-white rounded-[6px] border border-stone-300/90 p-8 sm:p-10 shadow-[0_15px_40px_-15px_rgba(28,25,23,0.08)] flex flex-col justify-between group hover:border-stone-900 transition-colors duration-300 relative overflow-hidden',
        { 'is-active': active },
    ]}
    data-tech-slide
    aria-hidden={!active}
>
    <div class:list={[image ? 'mb-8' : metrics.length ? 'mb-6' : '']}>
        <div class="flex items-center justify-between gap-4 mb-4">
            <span class="font-mono text-[11px] tracking-[0.2em] text-stone-500 uppercase font-medium">
                {eyebrow}
            </span>
            {status ? (
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-label="Sistema ativo"></span>
            ) : badge ? (
                <span class:list={[
                    'font-mono text-[10px] px-2.5 py-1 rounded uppercase',
                    badge === '100% INDELÉVEL'
                        ? 'bg-stone-900 text-white font-medium'
                        : 'bg-stone-100 text-stone-700 border border-stone-200',
                ]}>
                    {badge}
                </span>
            ) : null}
        </div>

        {icon ? (
            <div class="w-12 h-12 bg-stone-100 rounded-lg flex items-center justify-center text-stone-900 mb-6 border border-stone-200 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-300">
                <iconify-icon icon={icon} class="text-2xl"></iconify-icon>
            </div>
        ) : null}

        <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 mb-3">
            {title}
        </h3>
        <p class:list={[
            'text-sm sm:text-base text-stone-600 font-light leading-relaxed',
            image || metrics.length ? 'mb-6' : '',
            image ? 'max-w-xl' : '',
        ]}>
            {description}
        </p>
    </div>

    {image ? (
        <div class="relative rounded-[4px] overflow-hidden border border-stone-200 bg-stone-950 p-2 group-hover:border-stone-400 transition-colors">
            <Image
                src={image}
                alt={imageAlt}
                loading="lazy"
                decoding="async"
                class="w-full h-56 sm:h-64 object-cover object-center rounded-[3px] group-hover:scale-105 transition-transform duration-700 ease-out select-none"
            />
            {imageBadges.map((imageBadge, index) => (
                <div class:list={[
                    'absolute bottom-4 bg-white/95 text-stone-900 backdrop-blur-md px-3 py-1 rounded text-[10px] font-mono tracking-wider uppercase border border-stone-300 font-medium',
                    index === 0 ? 'left-4 bg-stone-900/90 text-white border-stone-700' : 'right-4',
                ]}>
                    {imageBadge}
                </div>
            ))}
        </div>
    ) : metrics.length ? (
        <div class:list={[
            'pt-6 border-t border-stone-200 grid gap-4',
            metrics.length === 3 ? 'grid-cols-1 sm:grid-cols-3 gap-6' : 'grid-cols-2',
        ]}>
            {metrics.map((metric) => (
                <div class:list={[
                    metrics.length === 3 ? 'bg-stone-50 p-4 rounded border border-stone-200/80' : '',
                ]}>
                    <div class="font-display text-2xl font-bold text-stone-900">{metric.value}</div>
                    <div class:list={[
                        metrics.length === 3 ? 'text-xs text-stone-600 mt-1 font-medium' : 'text-[11px] font-mono text-stone-500 uppercase mt-0.5',
                    ]}>
                        {metric.label}
                    </div>
                    {metric.detail ? (
                        <div class:list={[
                            metrics.length === 3 ? 'text-[10px] font-mono text-stone-400 uppercase mt-0.5' : 'text-[11px] font-mono text-stone-500 uppercase mt-0.5',
                        ]}>
                            {metric.detail}
                        </div>
                    ) : null}
                </div>
            ))}
        </div>
    ) : null}
</article>
